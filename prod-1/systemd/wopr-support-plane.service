[Unit]
Description=WOPR Support Plane (Prod-1, strict manifest: heals only what services-manifest.json lists) WOPR-260
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/wopr/support-plane/wopr-support-plane.py daemon
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wopr-support-plane
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
